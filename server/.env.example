# Tapo "Camera Account" credentials (set in the Tapo app under Advanced Settings)
CAMERA_IP=192.168.1.100
CAMERA_USER=tapo_admin
CAMERA_PASS=changeme

# ONVIF port on Tapo cams is usually 2020. Older firmware sometimes uses 8080.
CAMERA_ONVIF_PORT=2020

# Node server (proxies /stream to go2rtc and serves the Angular bundle)
SERVER_PORT=8080
GO2RTC_URL=http://127.0.0.1:1984

# Path to the built Angular browser bundle, relative to server/dist/
WEB_DIST=../../web/dist/tapo-viewer-web/browser
