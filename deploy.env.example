# Copy to deploy.env (gitignored) and edit to override publish.ps1 defaults.
# CLI args to publish.ps1 still take precedence over these.

PiHost=wormhole.local
PiUser=jared
RemoteDir=/home/jared/tapo-viewer

# Optional: extra WebRTC ICE candidate host advertised by go2rtc.
# Set to the Pi's WireGuard IP so VPN clients can negotiate media when
# PiHost (mDNS / LAN-only) isn't reachable through the tunnel.
# PiWgHost=10.210.235.1
