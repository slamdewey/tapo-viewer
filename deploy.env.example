# Copy to deploy.env (gitignored) and edit to match your Pi.
# CLI args to publish.mjs still take precedence over these.

PiHost=raspberrypi.local
PiUser=pi
RemoteDir=~/scry

# Optional: a second host the browser can use for WebRTC media. Set to a
# routable IP (e.g. the Pi's VPN address) so clients reaching the site over
# a VPN can also receive the WebRTC stream. Leave commented to skip.
# PiWgHost=10.0.0.1
