[Unit]
Description=go2rtc streaming server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jared/tapo-viewer
ExecStart=/usr/local/bin/go2rtc -config /home/jared/tapo-viewer/go2rtc.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
